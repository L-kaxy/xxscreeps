{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "customBadge": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "maxShapes": { "type": "integer", "minimum": 1, "maximum": 64, "default": 32 },
        "maxPathLength": { "type": "integer", "minimum": 1024, "maximum": 131072, "default": 32768 },
        "saveCooldownSeconds": { "type": "number", "minimum": 0, "maximum": 3600, "default": 10 },
        "adminUsers": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-f0-9]+$", "maxLength": 64 }, "default": [] }
      }
    }
  }
}
